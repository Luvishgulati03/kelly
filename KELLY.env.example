# Kelly Configuration (.env for `kelly` command)
# Copy this to .env and customize for your setup

# Profile (automatically set by bin/kelly.mjs, but you can override)
# AGENT_PROFILE=kelly

# Data and memory directories (separate from Henry)
KELLY_DATA_DIR=data/kelly
KELLY_MEMORY_DIR=memory/kelly

# Dashboard (local access only by default)
KELLY_HOST=127.0.0.1
KELLY_PORT=7338
# KELLY_DASHBOARD_TOKEN=optional-security-token
# KELLY_ALLOW_REMOTE_DASHBOARD=0

# LLM Provider
# Provider: "claude" or "codex"
KELLY_PROVIDER=claude
# KELLY_CLAUDE_MODEL=          (leave blank for CLI default)
# KELLY_CLAUDE_T0_MODEL=haiku  (fast worker)
# KELLY_CLAUDE_T2_MODEL=opus   (deep researcher)

# Quotation data
# Kelly's knowledge base for quotation patterns
KELLY_KNOWLEDGE_DIR=knowledge/kelly

# Telegram notifications (optional — leave empty to disable)
# KELLY_TELEGRAM_BOT_TOKEN=your-bot-token
# KELLY_TELEGRAM_CHAT_ID=your-chat-id

# Email (intentionally not configured for Kelly)
# Kelly does not support Gmail integration by design

# Security
KELLY_REQUIRE_OUTBOUND_APPROVAL=1

# Performance
KELLY_BROWSER_HEADLESS=1

# Personal Info
# Kelly's owner email (for notifications)
# KELLY_OWNER_EMAIL=your-email@example.com
