# Kelly Configuration (.env for `kelly` command)
# Copy this to .env and customize for your setup

# Profile (automatically set by bin/kelly.mjs, but you can override)
# AGENT_PROFILE=kelly

# Trade pack: fixed per install, chosen at setup
KELLY_TRADE=electrical  # electrical | boutique, fixed per install, chosen at setup
# KELLY_SHOP_NAME=

# Data and memory directories (separate from Henry)
KELLY_DATA_DIR=data/kelly
KELLY_MEMORY_DIR=memory/kelly

# Dashboard (local access only by default)
KELLY_HOST=127.0.0.1
KELLY_PORT=7338
# KELLY_DASHBOARD_TOKEN=optional-security-token
# KELLY_ALLOW_REMOTE_DASHBOARD=0

# LLM Provider
# Provider: "claude" or "codex"
KELLY_PROVIDER=codex
# KELLY_CLAUDE_MODEL=          (leave blank for CLI default)
# KELLY_CLAUDE_T0_MODEL=haiku  (fast worker)
# KELLY_CLAUDE_T2_MODEL=opus   (deep researcher)

# Quotation data
# Kelly's knowledge base for quotation patterns
KELLY_KNOWLEDGE_DIR=knowledge/kelly

# Local speech services (optional)
# Whisper.cpp multilingual small quantized model is the recommended transcription baseline.
# Explicit local paths; Kelly does not download weights automatically.
# KELLY_WHISPER_CPP_PATH=/opt/homebrew/bin/whisper-cli
# KELLY_WHISPER_MODEL_PATH=/path/to/ggml-small-q5_1.bin
# Natural local TTS: Kokoro-82M via the persistent kokoro-onnx worker.
# The worker requires a bearer token; use the same secret on both sides.
# KELLY_KOKORO_URL=http://127.0.0.1:8765
# KELLY_KOKORO_TOKEN=replace-with-a-local-secret
# Local model assets (no automatic downloads); start with `kelly voice serve`.
# KELLY_VOICE_PYTHON=data/voice/venv/bin/python
# KELLY_KOKORO_MODEL_PATH=data/voice/models/kokoro-v1.0.int8.onnx
# KELLY_KOKORO_VOICES_PATH=data/voice/models/voices-v1.0.bin
# Optional lightweight, robotic fallback: espeak-ng (no model download).
# KELLY_TTS_ENGINE=espeak-ng
# KELLY_TTS_EXECUTABLE=/opt/homebrew/bin/espeak-ng

# Telegram owner voice notes (optional)
# Requires Telegram below, local Whisper above, and an existing ffmpeg binary.
# Kelly never installs ffmpeg or downloads speech models automatically.
# KELLY_FFMPEG_PATH=/opt/homebrew/bin/ffmpeg
# KELLY_TELEGRAM_VOICE=1
# KELLY_TELEGRAM_VOICE_MAX_BYTES=20971520
# KELLY_TELEGRAM_VOICE_MAX_SECONDS=300
# KELLY_TELEGRAM_VOICE_LANGUAGE=auto
# Optional: send short spoken answers after the normal text answer.
# KELLY_TELEGRAM_VOICE_REPLIES=0

# Telegram notifications (optional — leave empty to disable)
# KELLY_TELEGRAM_BOT_TOKEN=your-bot-token
# KELLY_TELEGRAM_CHAT_ID=your-chat-id

# Email (intentionally not configured for Kelly)
# Kelly does not support Gmail integration by design

# Remote access (optional: a shop tablet reaching this Mac's dashboard, or a public
# demo link). Kelly's dashboard always binds to 127.0.0.1; this only starts a tunnel
# process that forwards into that loopback address.
# See docs/modules/remote-access.md.
# KELLY_TUNNEL=off               off (default) | tailscale | cloudflare | funnel
#   tailscale: tailnet-only (Tailscale Serve) — the tablet must join the same tailnet.
#   funnel:    public (Tailscale Funnel) — anyone with the link can reach the login page;
#              `kelly start --demo --trade boutique --public` sets this automatically.
#   cloudflare: fallback for a tablet that cannot join a tailnet.
# KELLY_TAILSCALE_PATH=tailscale         path to the tailscale binary (also tried at
#                                         /Applications/Tailscale.app/Contents/MacOS/Tailscale)
# KELLY_CLOUDFLARED_PATH=cloudflared     path to the cloudflared binary
# KELLY_CLOUDFLARE_TUNNEL=my-kelly-shop  named tunnel to run (required for cloudflare mode)
# KELLY_TUNNEL_PORT=                     defaults to KELLY_PORT

# Security
KELLY_REQUIRE_OUTBOUND_APPROVAL=1

# Performance
KELLY_BROWSER_HEADLESS=1

# Personal Info
# Kelly's owner email (for notifications)
# KELLY_OWNER_EMAIL=your-email@example.com
