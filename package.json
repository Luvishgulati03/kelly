{
  "name": "kelly-agent",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "description": "A locally running, configurable business agent for Indian small businesses.",
  "type": "module",
  "bin": {
    "kelly": "./bin/kelly.mjs",
    "kelly-excel-mcp": "./bin/kelly-excel-mcp.mjs"
  },
  "scripts": {
    "dev": "tsx src/cli.ts repl",
    "start": "tsx src/cli.ts repl",
    "typecheck": "tsc --noEmit",
    "test": "tsx --import ./tests/isolate.mjs --test-concurrency=1 --test tests/**/*.test.ts",
    "dashboard": "tsx src/cli.ts dashboard",
    "schedule": "tsx src/cli.ts schedule daemon",
    "build": "tsc --outDir dist --declaration --noEmit false",
    "handbook:build": "node scripts/build-handbook.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "@modelcontextprotocol/sdk": "^1.17.5",
    "@ricky0123/vad-web": "^0.0.31",
    "better-sqlite3": "12.11.1",
    "croner": "^9.0.0",
    "dotenv": "^16.4.7",
    "engram-memory": "https://codeload.github.com/Luvishgulati03/improved-engram/tar.gz/9075397cea68dd6296516336e865df346c8dd0e6",
    "exceljs": "^4.4.0",
    "mongodb": "^7.5.0",
    "onnxruntime-web": "^1.30.0",
    "pdf-parse": "^1.1.1",
    "playwright": "^1.62.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.13.4",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3"
  }
}
